# Supabase pripojenie (Získate na app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Resend API (Transakčné e-mailové API – 3 000 e-mailov/mesiac zadarmo na https://resend.com)
# Získate na: https://resend.com/api-keys
RESEND_API_KEY=re_123456789abcdef

# Vlastná overená doména z Namecheap (100% do doručenej pošty, nie do spamu):
# Možnosť A (Odporúčané - automaticky doplní meno freelancera):
RESEND_FROM_EMAIL=notifikacie@tvojadomena.com

# Možnosť B (Pevné meno odosielateľa):
# RESEND_FROM=DropBrief <notifikacie@tvojadomena.com>
