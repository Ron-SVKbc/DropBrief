# Supabase pripojenie (Získate na app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Gmail SMTP (Alternatívne bezplatné odosielanie pripomienok)
# Vygenerujte 16-miestne heslo na: https://myaccount.google.com/apppasswords
GMAIL_USER=tvoj.email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Resend API (Odporúčané moderné transakčné API – 3 000 e-mailov/mesiac zadarmo na resend.com)
# Získate na: https://resend.com/api-keys
RESEND_API_KEY=re_123456789abcdef
# Predvolená testovacia adresa je DropBrief <onboarding@resend.dev> (alebo vaša vlastná overená doména)
RESEND_FROM=DropBrief <onboarding@resend.dev>
